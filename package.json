{
  "name": "qrcore",
  "version": "0.3.0",
  "description": "Modern QR Code generator with typed ESM, CommonJS, and CLI support.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/summer-illusion/qrcore.git"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "qrcore": "./dist/cli.mjs",
    "qrcode": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{mts,cts,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "ci": "npm run lint && npm run check && npm run test && npm run build && npm run smoke && npm run pack:dry",
    "commit-push": "node scripts/commit-push.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changelog": "node scripts/generate-changelog.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "pack:dry": "npm pack --dry-run",
    "prepare": "husky",
    "version:bump": "node scripts/auto-bump-version.mjs",
    "release": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs",
    "prepack": "npm run build && npm run test && npm run smoke"
  },
  "dependencies": {
    "cleye": "^2.6.0",
    "dijkstrajs": "^1.0.3",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^24.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.65.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
